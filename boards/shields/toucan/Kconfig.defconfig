if SHIELD_TOUCAN_LEFT

config ZMK_KEYBOARD_NAME
    default "Toucan"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif



if SHIELD_TOUCAN_LEFT || SHIELD_TOUCAN_RIGHT

config SPI
    default y

config ZMK_SPLIT
    default y

config ZMK_POINTING
    default y

config INPUT_THREAD_PRIORITY_OVERRIDE
    default y

config INPUT_THREAD_PRIORITY
    default 8

# INPUT_THREAD_STACK_SIZE is intentionally NOT set here: Zephyr's subsys/input Kconfig
# already provides `default 1024` and the first default encountered wins, so a shield
# default here loses the race. It's set directly in each half's .conf instead.

config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 40

endif
